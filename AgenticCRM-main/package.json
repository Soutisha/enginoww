{
  "name": "agentic-crm",
  "version": "1.5.2",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:api": "turbo dev --filter=api",
    "dev:whatsapp": "turbo dev --filter=whatsapp",
    "dev:worker": "turbo dev --filter=worker",
    "dev:dashboard": "turbo dev --filter=dashboard",
    "db:migrate": "dotenv -e .env -- turbo db:migrate --filter=@wacrm/database",
    "db:seed": "dotenv -e .env -- turbo db:seed --filter=@wacrm/database",
    "db:studio": "dotenv -e .env -- turbo db:studio --filter=@wacrm/database",
    "db:generate": "turbo db:generate --filter=@wacrm/database",
    "db:push": "dotenv -e .env -- turbo db:push --filter=@wacrm/database",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:task09": "node scripts/verify-task09.mjs",
    "verify:task10": "node scripts/verify-task10.mjs",
    "verify:task11": "node scripts/verify-task11.mjs",
    "verify:task12": "node scripts/verify-task12.mjs",
    "verify:task13": "node scripts/verify-task13.mjs",
    "verify:task14": "node scripts/verify-task14.mjs",
    "verify:task15": "node scripts/verify-task15.mjs",
    "verify:task16": "node scripts/verify-task16.mjs",
    "verify:task17": "node scripts/verify-task17.mjs",
    "verify:task18": "node scripts/verify-task18.mjs",
    "verify:task19": "node scripts/verify-task19.mjs",
    "verify:task20": "node scripts/verify-task20.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "db:seed-demo": "pnpm --filter @wacrm/database exec tsx ../../scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.5",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "protobufjs",
      "unrs-resolver"
    ],
    "overrides": {
      "lodash": "^4.18.0",
      "multer": "^2.1.1",
      "picomatch": "^4.0.4",
      "glob": "^11.0.0",
      "js-yaml": "^4.1.1",
      "ajv@^6": "6.14.0",
      "ajv@^8": "8.18.0",
      "tmp": "^0.2.5",
      "music-metadata": "^11.12.3",
      "file-type": "^21.3.2",
      "webpack": "^5.104.0",
      "path-to-regexp": "^8.4.2",
      "@hono/node-server": "^1.19.13",
      "protobufjs": "^7.5.5",
      "follow-redirects": "^1.16.0",
      "fast-xml-parser": "^5.7.0",
      "hono": "^4.12.14",
      "@anthropic-ai/sdk": "^0.92.0",
      "uuid": "^14.0.0",
      "postcss": "^8.5.13"
    }
  }
}
